---
import "../styles/global.css";

import { name } from "../data/consts.ts";

interface Props {
	title?: string;
	description?: string;
	wide?: boolean;
}

const siteTitle = name;
const siteDescription = `Academic portfolio of ${name}`;

const {
	title = siteTitle,
	description = siteDescription,
	wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
	{ href: "/", label: "About" },
	{ href: "/publications", label: "Publications" },
	//{ href: "/projects", label: "Projects" },
	{ href: "/cv", label: "CV" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<title>{title}</title>
	</head>

	<body class="flex min-h-screen flex-col bg-white font-sans antialiased">
		<header
			class="mx-auto w-full max-w-3xl px-6 py-8 sm:py-10"
		>
			<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
				<a
					href="/"
					class="w-fit text-sm font-medium tracking-tight text-zinc-950 transition-colors hover:text-accent-hover"
				>
					{name}
				</a>

				<nav
					aria-label="Main navigation"
					class="flex items-center gap-5 text-sm sm:gap-6"
				>
					{
						navItems.map(({ href, label }) => {
							const isActive =
								href === "/"
									? pathname === "/"
									: pathname.startsWith(href);

							return (
								<a
									href={href}
									aria-current={isActive ? "page" : undefined}
									class:list={[
										"transition-colors hover:text-accent-hover",
										isActive
											? "font-medium text-zinc-950"
											: "text-zinc-500",
									]}
								>
									{label}
								</a>
							);
						})
					}
				</nav>
			</div>
		</header>

		<main
			class:list={[
				"mx-auto w-full flex-1 px-6 pb-20",
				wide ? "max-w-5xl" : "max-w-3xl",
			]}
		>
			<slot />
		</main>

		<footer class="border-t border-zinc-200 box-border">
			<div class="mx-auto max-w-3xl px-6 py-8">
				<p class="text-center text-sm text-zinc-500">
					&copy; {new Date().getFullYear()} {name}. All rights reserved.
				</p>
			</div>
		</footer>
	</body>
</html>
